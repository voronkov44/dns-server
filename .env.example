# HTTP address used by the server to listen for incoming requests
# Examples: :8080, 127.0.0.1:8080, 0.0.0.0:8080
DNS_MANAGER_HTTP_ADDR=:8080

# Path to resolv.conf managed by the server
# For local development, use ./resolv.conf
# For real host DNS management, use /etc/resolv.conf
DNS_MANAGER_RESOLV_CONF_PATH=./resolv.conf

# HTTP server timeouts
DNS_MANAGER_READ_HEADER_TIMEOUT=5s
DNS_MANAGER_SHUTDOWN_TIMEOUT=10s

# Logging
DNS_MANAGER_LOG_LEVEL=info
DNS_MANAGER_LOG_FILE_PATH=logs/dns-server.log

# URL used by the CLI to connect to the server
# Usually it should match the server host and port
DNS_MANAGER_SERVER_URL=http://localhost:8080

